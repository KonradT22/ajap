# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit it.

# ── LLM classification (Google Gemini) ──────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash  # gemini-2.0-flash was deprecated Feb 2026 and shut off Mar 3 2026
GEMINI_RPM=150  # paid Tier-1 ≈150-300 RPM; set to 10 for free tier

# ── Human-in-the-loop alerts ────────────────────────────────────
# Discord (preferred — set webhook URL, leave SMTP blank)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/yyyy
# Email fallback (only used if DISCORD_WEBHOOK_URL is empty)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=you@gmail.com
SMTP_TO=you@gmail.com

# ── Optional: Google Sheets mirror for mobile viewing ───────────
# Path to your OAuth client secret JSON (also gitignored)
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_SHEET_ID=

# ── Runtime knobs ───────────────────────────────────────────────
# Where the SQLite file lives
DB_PATH=data/ajap.db
# Minutes between ingestion polls (jitter applied in code)
POLL_INTERVAL_MINUTES=30
